# Environment Variables Example

# Application Settings
APP_NAME="AI Financial Research Assistant"
ENV="development"
DEBUG=True

# LLM & Ollama Configuration
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="phi3"
LLM_TEMPERATURE=0.1
LLM_TIMEOUT=60.0

# Vector Database (ChromaDB)
CHROMA_PERSIST_DIR="./chroma_db"
CHROMA_COLLECTION_NAME="financial_research"

# Embedding Model
EMBEDDING_MODEL_NAME="all-MiniLM-L6-v2"

# Database Configuration (SQLite)
DATABASE_URL="sqlite:///./financial_assistant.db"

# Financial Data APIs (Optional / Configurable)
# Alpha Vantage API Key (Free tier available at https://www.alphavantage.co/support/#api-key)
ALPHA_VANTAGE_API_KEY="demo"
# Financial Modeling Prep API Key (Free tier at https://site.financialmodelingprep.com/)
FMP_API_KEY=""

# RAG & Grounding Settings
TOP_K_RETRIEVAL=4
GROUNDING_THRESHOLD=0.75
